#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba16f, set = 0, binding = 0) uniform writeonly image2D outTexture;

layout(push_constant) uniform compute_constants {
    mat4 data1;
    vec4 data2;
    vec4 data3;
    vec4 data4;
    vec4 data5;
}
push;

void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outTexture);

    if (texelCoord.x >= size.x || texelCoord.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(texelCoord) + vec2(0.5)) / vec2(size);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0);

    vec4 target = push.data1 * vec4(ndc.x, ndc.y, 1.0, 1.0);
    vec3 rayDir = normalize(target.xyz / target.w);

    float viewHeight = rayDir.y;

    vec3 lightDir = normalize(push.data2.xyz);
    float sunHeight = lightDir.y;

    float dayFactor = smoothstep(-0.1, 0.3, sunHeight);
    float sunsetFactor = smoothstep(0.3, -0.1, sunHeight) * smoothstep(-0.4, 0.0, sunHeight);

    vec3 zenithDay = vec3(0.1, 0.35, 0.75);
    vec3 zenithSunset = vec3(0.05, 0.1, 0.3);
    vec3 zenithNight = vec3(0.015, 0.022, 0.045);
    vec3 colorZenith = mix(mix(zenithNight, zenithSunset, sunsetFactor), zenithDay, dayFactor);

    vec3 horizonDay = vec3(0.55, 0.75, 0.9);
    vec3 horizonSunset = vec3(0.9, 0.35, 0.15);
    vec3 horizonNight = vec3(0.03, 0.04, 0.065);
    vec3 colorHorizon = mix(mix(horizonNight, horizonSunset, sunsetFactor), horizonDay, dayFactor);

    vec3 groundDay = vec3(0.02, 0.02, 0.03);
    vec3 groundSunset = vec3(0.01, 0.005, 0.005);
    vec3 groundNight = vec3(0.005, 0.006, 0.008);
    vec3 colorGround = mix(mix(groundNight, groundSunset, sunsetFactor), groundDay, dayFactor);

    vec3 skyColor = vec3(0.0);
    if (viewHeight >= 0.0) {
        skyColor = mix(colorHorizon, colorZenith, viewHeight);
    } else {
        skyColor = mix(colorHorizon, colorGround, pow(-viewHeight, 0.3));
    }

    vec3 nightAmbient = mix(vec3(0.02, 0.03, 0.05), vec3(0.008, 0.012, 0.025), max(viewHeight, 0.0));
    skyColor = max(skyColor, nightAmbient);

    float sunDot = max(dot(rayDir, lightDir), 0.0);

    float sunDisc = pow(sunDot, 8000.0);
    float sunGlow = pow(sunDot, 30.0) * 0.2;

    vec3 sunColorDay = vec3(1.0, 0.85, 0.65) * 6.0;
    vec3 sunColorSunset = vec3(1.0, 0.4, 0.1) * 4.0;
    vec3 sunColor = mix(sunColorSunset, sunColorDay, dayFactor);

    float sunVisibility = smoothstep(-0.2, 0.05, sunHeight);
    vec3 finalSun = (sunColor * sunDisc) + (sunColor * sunGlow);
    finalSun *= sunVisibility;

    vec3 finalColor = skyColor + finalSun;

    imageStore(outTexture, texelCoord, vec4(finalColor, 1.0));
}
